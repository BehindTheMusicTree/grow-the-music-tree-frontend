#!/bin/sh
# Re-syncs node_modules when a merge/pull brings in a different pnpm-lock.yaml,
# so a stale local install doesn't silently drift from the pinned versions
# (e.g. package.json says 4.5.2 but node_modules still has 4.4.3).

if ! git diff --quiet ORIG_HEAD HEAD -- pnpm-lock.yaml; then
  echo "pnpm-lock.yaml changed — running pnpm install to sync node_modules..."
  pnpm install --frozen-lockfile
fi
