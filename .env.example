# Copy to .env.local (gitignored) and fill in. Validated at boot by src/lib/env.server.ts.

# Any random string: `openssl rand -base64 33`
AUTH_SECRET=
# Dev Google OAuth client (docs/frontend-auth.md → Setup 1.6–1.7). Sign-in also needs a local grow-api below.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: point at a local grow-api instead of staging, e.g. http://127.0.0.1:8000/v1/
# NEXT_PUBLIC_GROW_BACKEND_BASE_URL=
