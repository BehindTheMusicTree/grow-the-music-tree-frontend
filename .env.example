# Copy to .env.local (gitignored) and fill in. Validated at boot by src/lib/env.server.ts.

# Any random string: `openssl rand -base64 33`
AUTH_SECRET=
# Dev Google OAuth client (docs/frontend-auth.md → Setup 1.6–1.7). Sign-in needs the local grow-api set up with the same client ID.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: read-only UI work against staging data instead of a local grow-api (origin only; the app appends /v1/).
# Admin sign-in fails there: staging rejects dev-client tokens.
# GROW_API_ORIGIN=https://grow-api-staging.themusictree.org
