# Copy to .env.local (gitignored) and fill in. Validated at boot by src/lib/env.server.ts.

# Any random string: `openssl rand -base64 33`
AUTH_SECRET=
# Dev Google OAuth client (docs/frontend-auth.md → Setup 1.6–1.7). Sign-in needs the local grow-api set up with the same client ID.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# `./scripts/dev-up.sh` targets read-only staging by default (admin sign-in fails there: staging rejects
# dev-client tokens); `./scripts/dev-up.sh --local` uses a local grow-api. `dev-up.sh` pins GROW_API_ORIGIN itself.

# Optional trusted country path: configure both server-only tokens together (32+ characters).
# EDGE_VIEWER_CONTEXT_TOKEN=
# VIEWER_CONTEXT_TOKEN=
