{
  "name": "grow-the-music-tree",
  "private": true,
  "version": "3.19.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "next dev --turbo --hostname localhost",
    "build": "next build",
    "build:debug": "NODE_ENV=development next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "postversion": "node scripts/update-changelog-release.mjs && git add CHANGELOG.md && git commit --amend --no-edit && (v=$(node -p \"require('./package.json').version\"); git tag -d v$v 2>/dev/null; git tag v$v) && node scripts/delete-test-dev-tags.mjs"
  },
  "dependencies": {
    "@behindthemusictree/app-kit": "26.0.0",
    "@behindthemusictree/app-kit-ui": "26.0.0",
    "@behindthemusictree/brand": "12.6.0",
    "@behindthemusictree/ui": "0.8.0",
    "@fortawesome/fontawesome-svg-core": "6.5.2",
    "@fortawesome/free-solid-svg-icons": "6.5.2",
    "@fortawesome/react-fontawesome": "3.1.1",
    "@heroicons/react": "2.2.0",
    "@sentry/nextjs": "10.77.1",
    "@tailwindcss/forms": "0.5.7",
    "@tanstack/react-query": "5.72.2",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "env-cmd": "10.1.0",
    "is-fullwidth-code-point": "3.0.0",
    "lucide-react": "0.487.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "prop-types": "15.8.1",
    "raf": "3.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-howler": "5.2.0",
    "react-icons": "5.7.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.2.0",
    "uuid": "10.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "5.72.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/d3": "7.4.3",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@typescript-eslint/eslint-plugin": "8.29.0",
    "@typescript-eslint/parser": "8.29.0",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "autoprefixer": "10.4.21",
    "dotenv": "16.4.5",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.5.0",
    "git-worktree-scripts": "1.4.1",
    "happy-dom": "21.0.4",
    "jsdom": "28.0.0",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "8.54.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@11.5.2"
}
